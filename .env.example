# ==============================================================================
# PANELDAYS OFFICIAL WEBSITE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local testing, or configure these variables
# directly in the Vercel Dashboard under Settings > Environment Variables.
#
# IMPORTANT:
# - Never commit actual API keys or secret credentials to Git.
# - D:\privacypolicy\.gitignore is configured to ignore all .env* files except .env.example.
# ==============================================================================

# Clerk Secret Key (Required for authoritative external account deletion via Clerk Backend API)
# Obtain from Clerk Dashboard > API Keys > Secret Keys (e.g. sk_test_... or sk_live_...)
# WARNING: Keep this secret; never expose to client code or commit to source control.
CLERK_SECRET_KEY=

# Resend API Key (Required for server-side email dispatch of verification codes and notices)
# Sign up and obtain your API key at https://resend.com
# Example: re_123456789_abcdefghijklmnopqrstuvwxyz
RESEND_API_KEY=

# Verified sender email address
# If using Resend sandbox/testing without a custom domain, leave as:
# CONTACT_FROM_EMAIL="PanelDays Support <onboarding@resend.dev>"
# Once your domain (e.g. paneldays.app) is verified in Resend, use:
# CONTACT_FROM_EMAIL="PanelDays Support <notifications@paneldays.app>"
CONTACT_FROM_EMAIL="PanelDays Support <onboarding@resend.dev>"

# Sender email for Account Deletion verification codes & notices
DELETION_FROM_EMAIL="PanelDays Account Security <onboarding@resend.dev>"

# Destination email for all support inquiries and deletion notices
# Official PanelDays support address
SUPPORT_RECIPIENT_EMAIL="paneldays@gmail.com"
